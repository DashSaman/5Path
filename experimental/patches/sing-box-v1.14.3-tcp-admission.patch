+package socks
+
+import (
+	"context"
+	E "github.com/sagernet/sing/common/exceptions"
+	"net"
+)
+
+// nil would make the SOCKS library bind a default ephemeral UDP socket.
+type denyAdmissionPacketListener struct{}
+
+func (denyAdmissionPacketListener) ListenPacket(net.ListenConfig, context.Context, string, string) (net.PacketConn, error) {
+	return nil, E.New("5Path admission is TCP-only")
+}
