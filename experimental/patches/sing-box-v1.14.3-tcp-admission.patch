+++ b/common/listener/tcp_admission_test.go
@@ -0,0 +1,52 @@
+package listener
+
+import (
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"sync"
+	"testing"
+)
+
+func TestFivePathAdmissionConcurrentReservationsAndOnceRelease(t *testing.T) {
+	a := newTCPAdmission(3)
+	var lock sync.Mutex
+	var retained []N.CloseHandlerFunc
+	var peers []net.Conn
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			c, p := net.Pipe()
+			release, ok := a.reserve(c)
+			if ok {
+				lock.Lock()
+				retained = append(retained, release)
+				peers = append(peers, p)
+				lock.Unlock()
+			} else {
+				_ = c.Close()
+				_ = p.Close()
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if len(retained) != 3 || a.active.Load() != 3 {
+		t.Fatalf("admitted=%d active=%d", len(retained), a.active.Load())
+	}
+	for i, release := range retained {
+		release(nil)
+		release(nil)
+		var b [1]byte
+		if _, err := peers[i].Read(b[:]); err == nil {
+			t.Fatal("slot released before original closed")
+		}
+		_ = peers[i].Close()
+	}
+	if a.active.Load() != 0 {
+		t.Fatalf("leaked/negative slots: %d", a.active.Load())
+	}
+}
