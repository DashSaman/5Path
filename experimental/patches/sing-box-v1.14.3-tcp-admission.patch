@@ -0,0 +1,41 @@
+package listener
+
+import (
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"sync"
+	"sync/atomic"
+)
+
+// A per-listener application cap. It does not count other frontends or SYN backlog.
+type tcpAdmission struct {
+	limit  int32
+	active atomic.Int32
+}
+
+func newTCPAdmission(limit int) *tcpAdmission {
+	if limit <= 0 {
+		return nil
+	}
+	return &tcpAdmission{limit: int32(limit)}
+}
+
+func (a *tcpAdmission) reserve(conn net.Conn) (N.CloseHandlerFunc, bool) {
+	for {
+		current := a.active.Load()
+		if current >= a.limit {
+			return nil, false
+		}
+		if a.active.CompareAndSwap(current, current+1) {
+			break
+		}
+	}
+	var once sync.Once
+	return func(_ error) {
+		once.Do(func() {
+			// Route callbacks can precede its final common.Close: close original first.
+			_ = conn.Close()
+			a.active.Add(-1)
+		})
+	}, true
+}
